# Copie este arquivo para .env e preencha com valores reais.
# Nunca commitar o .env de verdade (já está no .gitignore).

# Ambiente
ENV=local                     # local | homologacao | producao
DEBUG=true

# API
APP_HOST=0.0.0.0
APP_PORT=8000

# Banco de dados (PostgreSQL + pgvector)
# Credenciais abaixo batem com o docker-compose.yml local.
DATABASE_URL=postgresql+asyncpg://estoque:estoque@localhost:5432/estoque_construcao

# Provedor de LLM: Hugging Face (mesmo padrao do wmsbox-agent).
# Gere um token gratuito (permissao "Inference") em https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_TEMPERATURE=0

# Origens com permissao de CORS (lista separada por virgula ou JSON)
CORS_ALLOW_ORIGINS=http://localhost:3000
