# Copie este arquivo para .env e preencha com valores reais.
# Nunca commitar o .env de verdade (já está no .gitignore).

# Ambiente
ENV=local                     # local | homologacao | producao
DEBUG=true

# API
APP_HOST=0.0.0.0
APP_PORT=8000

# Banco de dados (PostgreSQL + pgvector)
# Credenciais abaixo batem com o docker-compose.yml local.
DATABASE_URL=postgresql+asyncpg://estoque:estoque@localhost:5432/estoque_construcao

# Provedor de LLM: Groq (tier gratuito sem cartao, endpoint compativel com OpenAI).
# A Hugging Face era o plano original (mesmo padrao do wmsbox-agent), mas removeu
# o credito gratuito mensal em 15/10/2026 - trocamos pra Groq por isso.
# Gere uma chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0

# Origens com permissao de CORS (lista separada por virgula ou JSON)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Autenticacao do painel interno (funcionarios/dono da empresa).
# Gere um valor aleatorio proprio, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Nunca reaproveite o mesmo valor entre local/homologacao/producao.
JWT_SECRET=
JWT_EXPIRACAO_MINUTOS=480
