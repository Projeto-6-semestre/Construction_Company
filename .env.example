# Copie este arquivo para .env e preencha com valores reais.
# Nunca commitar o .env de verdade (já está no .gitignore).

# Ambiente
ENV=local                     # local | homologacao | producao
DEBUG=true

# API
APP_HOST=0.0.0.0
APP_PORT=8000

# Banco de dados (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/nome_do_banco

# Provedor de LLM (qual usar ainda está em aberto - ver CLAUDE.md secao 11)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
